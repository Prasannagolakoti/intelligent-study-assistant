# Intelligent Study Assistant Agent - Configuration
# Copy this file to .env and fill in your API key if you want cloud LLM features.
# If no API key is provided, the application will automatically run in high-accuracy Local Demonstration Mode.

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Active AI Provider: "gemini", "openai", or "local" (default: "gemini" if key present, else "local")
AI_PROVIDER=gemini

# Application Settings
APP_TITLE=Intelligent Study Assistant
MAX_FILE_SIZE_MB=20
ENABLE_LOCAL_DEMO_FALLBACK=true
